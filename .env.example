# .env.example - UntunginLOH Environment Configuration
# Salin file ini menjadi .env jika menghubungkan ke layanan API eksternal

# Port server lokal (default Vite: 5173 atau 8443)
PORT=5173

# Google Gemini API Key & Model
VITE_GEMINI_API_KEY=your_gemini_api_key_here
VITE_GEMINI_MODEL=gemini-3.5-flash-lite

# Mode Demo Otomatis (true / false)
VITE_DEMO_MODE=true
VITE_ENABLE_MOCK_DATA=true

